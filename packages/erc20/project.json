  "tags": [
    "scope:erc20",
    "env:runtime",
    "layer:1"
  ],
  "targets": {
    "lint": {},
    "typecheck": {},
    "test": {},
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.build.json"
      },
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
