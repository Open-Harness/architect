{
  "name": "prove",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/prove/src",
  "projectType": "library",
  "tags": [
    "scope:prove",
    "env:build",
    "layer:1"
  ],
  "targets": {
    "lint": {},
    "typecheck": {},
    "test": {
      "dependsOn": [
        {
          "projects": [
            "wallets"
          ],
          "target": "build"
        }
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.build.json"
      },
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.build.base.json"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    }
  }
}
