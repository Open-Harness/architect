// The Worker the tests run in: real workerd, a real local D1, the world Durable Object. Nothing here reaches Cloudflare.
{
  "name": "host-cloudflare-test",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "AUTH_SECRET": "test-only-secret-at-least-32-characters-long" },
  "d1_databases": [
    { "binding": "DB", "database_name": "host-test", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" },
    { "binding": "DB_VAULT", "database_name": "host-test-vault", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations-vault" }
  ],
  "durable_objects": { "bindings": [{ "name": "WORLD", "class_name": "World" }, { "name": "ACTORS", "class_name": "Actor" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }, { "tag": "v2", "new_sqlite_classes": ["Actor"] }]
}
