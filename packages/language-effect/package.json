{
  "name": "@orthograph/language-effect",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./device": "./src/device.ts",
    "./visibility": "./src/visibility.ts"
  },
  "dependencies": {
    "orthograph": "workspace:*",
    "@cfworker/json-schema": "4.1.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "effect": "4.1.4",
    "zod": "4.5.4"
  },
  "imports": {
    "#modules/*.js": "./src/modules/*.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./device": {
        "types": "./dist/device.d.ts",
        "default": "./dist/device.js"
      },
      "./visibility": {
        "types": "./dist/visibility.d.ts",
        "default": "./dist/visibility.js"
      }
    },
    "imports": {
      "#modules/*.js": "./dist/modules/*.js"
    }
  }
}
