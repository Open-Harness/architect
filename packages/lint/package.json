{
  "name": "@orthograph/lint",
  "version": "0.1.0-next.1",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/main.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "imports": {
    "#modules/*.js": "./src/modules/*.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./plugin": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "./package.json": "./package.json"
    },
    "imports": {
      "#modules/*.js": "./dist/modules/*.js"
    }
  }
}
