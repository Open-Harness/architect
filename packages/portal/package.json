{
  "name": "@orthograph/portal",
  "version": "0.1.0-next.1",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "effect": "4.1.4"
  },
  "imports": {
    "#modules/*.js": "./src/modules/*.ts"
  },
  "devDependencies": {
    "@orthograph/logbook": "workspace:*",
    "@orthograph/portal-ui": "workspace:*",
    "@orthograph/services": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "orthograph": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./package.json": "./package.json"
    },
    "imports": {
      "#modules/*.js": "./dist/modules/*.js"
    }
  }
}
