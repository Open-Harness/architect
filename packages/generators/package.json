{
  "name": "@orthograph/generators",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "orthograph": "workspace:*",
    "@orthograph/compiler": "workspace:*",
    "@orthograph/portal": "workspace:*",
    "@orthograph/projections": "workspace:*",
    "@nx/devkit": "24.0.3",
    "effect": "4.1.4"
  },
  "generators": "./generators.json",
  "imports": {
    "#modules/*.js": "./src/modules/*.ts"
  },
  "devDependencies": {
    "nx": "24.0.3"
  },
  "exports": {
    ".": "./src/main.ts",
    "./sync": "./src/modules/sync/service.ts",
    "./package.json": "./package.json",
    "./render": "./src/modules/render/service.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "./sync": {
        "types": "./dist/modules/sync/service.d.ts",
        "default": "./dist/modules/sync/service.js"
      },
      "./package.json": "./package.json",
      "./render": {
        "types": "./dist/modules/render/service.d.ts",
        "default": "./dist/modules/render/service.js"
      }
    },
    "imports": {
      "#modules/*.js": "./dist/modules/*.js"
    }
  }
}
