{
  "name": "orthograph",
  "version": "0.1.0-next.1",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./sentences": "./src/sentences.ts",
    "./actions": "./src/actions.ts"
  },
  "dependencies": {
    "effect": "4.1.4"
  },
  "imports": {
    "#modules/*.js": "./src/modules/*.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./sentences": {
        "types": "./dist/sentences.d.ts",
        "default": "./dist/sentences.js"
      },
      "./actions": {
        "types": "./dist/actions.d.ts",
        "default": "./dist/actions.js"
      }
    },
    "imports": {
      "#modules/*.js": "./dist/modules/*.js"
    }
  }
}
