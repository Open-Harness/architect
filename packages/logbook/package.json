{
  "name": "@orthograph/logbook",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#modules/*.js": "./src/modules/*.ts"
  },
  "dependencies": {
    "effect": "4.1.4",
    "jose": "6.2.15",
    "wrangler": "4.156.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@orthograph/services": "workspace:*"
  },
  "files": [
    "dist",
    "src/main.ts",
    "wrangler.jsonc"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "imports": {
      "#modules/*.js": "./dist/modules/*.js"
    }
  }
}
