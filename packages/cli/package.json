{
  "name": "@orthograph/cli",
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@orthograph/compiler": "workspace:*",
    "@orthograph/generators": "workspace:*",
    "@orthograph/lint": "workspace:*",
    "@orthograph/projections": "workspace:*",
    "@orthograph/prove": "workspace:*",
    "orthograph": "workspace:*",
    "@effect/platform-node": "4.1.4",
    "effect": "4.1.4",
    "nx": "24.0.3",
    "wrangler": "4.156.1",
    "alchemy": "2.0.0-beta.87",
    "@alchemy.run/cloudflare": "2.0.0-beta.87"
  },
  "devDependencies": {
    "@orthograph/logbook": "workspace:*",
    "@orthograph/services": "workspace:*"
  },
  "bin": {
    "ortho": "./src/main.ts"
  },
  "imports": {
    "#modules/*.js": "./src/modules/*.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "imports": {
      "#modules/*.js": "./dist/modules/*.js"
    },
    "bin": {
      "ortho": "./dist/main.js"
    }
  }
}
