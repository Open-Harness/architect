{
  "name": "@orthograph/compiler",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts"
  },
  "dependencies": {
    "orthograph": "workspace:*",
    "effect": "4.1.4"
  },
  "imports": {
    "#modules/*.js": "./src/modules/*.ts"
  },
  "bin": {
    "ortho-model": "./src/main.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./main": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      }
    },
    "imports": {
      "#modules/*.js": "./dist/modules/*.js"
    },
    "bin": {
      "ortho-model": "./dist/main.js"
    }
  }
}
