    "./src/*.js": "./src/*.ts",
    "./src/*": "./src/*"
  },
  "dependencies": {
    "@earendil-works/pi-durable": "1.5.0",
    "@orthograph/language-effect": "workspace:*",
    "effect": "4.1.4",
    "orthograph": "workspace:*"
  }
