{
  "name": "@fixture/node-remote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/adapter.d.ts", "default": "./dist/adapter.js" },
    "./blueprint/*": { "types": "./dist/blueprint/*.d.ts", "default": "./dist/blueprint/*" },
    "./src/*": { "types": "./dist/src/*.d.ts", "default": "./dist/src/*" }
  },
  "orthograph": { "kind": "adapter", "blueprint": "./dist/blueprint", "src": "./dist/src" },
  "files": ["dist"],
  "peerDependencies": { "orthograph": "0.0.0", "@orthograph/language-effect": "0.0.0" }
}
