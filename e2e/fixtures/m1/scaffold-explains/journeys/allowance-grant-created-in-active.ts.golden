// Scaffolded from blueprint/things/allowance/machine.ts. Yours from now on.
import { Blueprint, emits } from "orthograph";
import { machine } from "../things/allowance/machine.ts";
import { owner } from "../things/organization/roles.ts";
import { AllowanceGranted } from "../things/allowance/events.ts";
import grant from "../things/allowance/verbs/grant.ts";

/**
 * One path through the allowance's machine, from blueprint/things/allowance/machine.ts:
 *   (creates)  grant  active  AllowanceGranted, by allowance.grant
 * Allowed: the owner of its organization calls allowance.grant, and the allowance is created in active.
 */
export default Blueprint.journey("allowance.grant: created in active", {
  cast: { owner },
  starts: Blueprint.todo("a starting world where allowance.grant can run"),
  steps: (s) => [
    s.step(
      "the owner calls allowance.grant",
      s.owner.run(grant, Blueprint.todo("allowance.grant's payload: organization, member, limit")),
      emits(AllowanceGranted, Blueprint.todo("AllowanceGranted's fields: allowance, limit")),
      machine.isIn(Blueprint.todo("the allowance's id"), "active"),
    ),
  ],
});
