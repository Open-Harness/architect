  "exclude": ["portal-next/fixtures/**", "superagent/journeys/**", "superagent/connection-worlds/**", "superagent/agent-journeys/**", "superagent/kit/**", "superagent/starting-worlds/**", "superagent/tapes/**", "superagent/tape/**"]
