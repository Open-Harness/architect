{
  "extends": "../tsconfig.base.json",
  "include": ["layer1/**/*.ts", "layer2/**/*.ts", "m0/**/*.ts", "m1/**/*.ts", "m2/**/*.ts", "m7/**/*.ts", "m8/**/*.ts", "from-doctype/**/*.ts", "ui-layer/**/*.ts", "climb/**/*.ts", "grid/**/*.ts", "served-portal/**/*.ts", "portal-next/**/*.ts", "ratchet/**/*.ts", "vitest.config.ts", "vitest.layer2.config.ts", "vitest.m0.config.ts", "vitest.m1.config.ts", "vitest.m1-ratchet.config.ts", "vitest.m2.config.ts", "vitest.m2-ratchet.config.ts", "vitest.m7.config.ts", "vitest.m7-ratchet.config.ts", "vitest.m8.config.ts", "vitest.m8-ratchet.config.ts", "vitest.from-doctype.config.ts", "vitest.from-doctype-ratchet.config.ts", "vitest.ui-layer.config.ts", "vitest.ui-layer-ratchet.config.ts", "vitest.ratchet.config.ts", "vitest.climb.config.ts", "vitest.grid.config.ts", "superagent/**/*.ts", "vitest.superagent.config.ts", "vitest.superagent-ratchet.config.ts"],
