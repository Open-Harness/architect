            },
            {
              "kind": "emits",
              "event": "CompanyCreated",
              "fields": {
                "company": {
                  "ref": [
                    "last",
                    "company"
                  ]
                },
                "owner": {
                  "ref": [
                    "cast",
                    "bo",
                    "person"
                  ]
                }
              }
            },
            {
              "kind": "is-in",
              "thing": "company",
              "id": {
                "ref": [
                  "last",
                  "company"
                ]
              },
              "state": "active"
            }
          ]
        },
        {
          "title": "Ada can't read Bo's company",
          "call": {
            "actor": "ada",
            "operation": "company.get",
            "payload": {
              "id": {
                "ref": [
                  "last",
                  "company"
                ]
              }
