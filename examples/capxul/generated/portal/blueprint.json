    "journeys": {
      "journeys/companies-are-kept-apart.ts": {
        "name": "companies are kept apart",
        "file": "journeys/companies-are-kept-apart.ts",
        "cast": {
          "ada": {
            "kind": "role",
            "role": "company.owner"
          },
          "bo": {
            "kind": "signed-in"
          }
        },
        "starts": "a company",
        "steps": [
          {
            "title": "Ada can't give a second company of hers the same name",
            "call": {
              "actor": "ada",
              "operation": "company.create",
              "payload": {
                "companyName": "Acme Trading",
                "abbr": "AT2",
                "country": "Kenya",
                "defaultCurrency": "USD"
              }
            },
            "checks": [
              {
                "kind": "refuses",
                "error": "CompanyNameTaken",
                "fields": {
                  "companyName": "Acme Trading"
                }
              },
              {
                "kind": "no-events"
              }
            ]
          },
          {
            "title": "nor the same abbreviation",
            "call": {
              "actor": "ada",
              "operation": "company.create",
              "payload": {
                "companyName": "Acme Holdings",
                "abbr": "AT",
                "country": "Kenya",
                "defaultCurrency": "USD"
              }
            },
            "checks": [
              {
                "kind": "refuses",
                "error": "CompanyAbbrTaken",
                "fields": {
                  "abbr": "AT"
                }
              },
              {
                "kind": "no-events"
              }
            ]
          },
          {
            "title": "Bo may use both for his own company, because her names don't bind him",
            "call": {
              "actor": "bo",
              "operation": "company.create",
              "payload": {
                "companyName": "Acme Trading",
                "abbr": "AT",
                "country": "Uganda",
                "defaultCurrency": "UGX"
              }
            },
            "checks": [
              {
                "kind": "expect",
                "match": "^com_[0-9a-z]+$",
                "flags": ""
              },
              {
                "kind": "emits",
                "event": "CompanyCreated",
                "fields": {
                  "company": {
                    "ref": [
                      "last",
                      "company"
                    ]
                  },
                  "owner": {
                    "ref": [
                      "cast",
                      "bo",
                      "person"
                    ]
                  }
                }
              },
              {
                "kind": "is-in",
                "thing": "company",
                "id": {
                  "ref": [
                    "last",
                    "company"
                  ]
                },
                "state": "active"
              }
            ]
          },
          {
            "title": "Bo still can't read Ada's",
            "call": {
              "actor": "bo",
              "operation": "company.get",
              "payload": {
                "id": {
                  "ref": [
                    "world",
                    "company"
                  ]
                }
              }
            },
            "checks": [
              {
                "kind": "refuses",
                "error": "NotAllowed",
                "fields": {}
              },
              {
                "kind": "no-events"
              }
            ]
          },
          {
            "title": "Ada's company is untouched and still hers",
            "call": {
              "actor": "ada",
              "operation": "company.get",
              "payload": {
                "id": {
                  "ref": [
                    "world",
                    "company"
                  ]
                }
              }
            },
            "checks": [
              {
                "kind": "expect-equal",
                "value": [
                  "Acme Trading",
                  "AT",
                  "Kenya",
                  "USD",
                  {
                    "ref": [
                      "cast",
                      "ada",
                      "person"
                    ]
                  },
                  "active"
                ]
              },
              {
                "kind": "no-events"
              }
            ]
          }
        ],
        "sourceHash": "68af707f20264a3493f7ca285ee3ebbc8c6f77c447c2a7164857365442e5a3a7"
      },
