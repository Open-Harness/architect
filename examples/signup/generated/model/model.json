            {
              "kind": "no-events"
            },
            {
              "kind": "spans",
              "present": [],
              "absent": [
                "sheet.join.record"
              ]
            }
          ]
        },
        {
          "title": "closing it again is refused",
          "call": {
            "actor": "visitor",
            "operation": "sheet.close",
            "payload": {
              "sheet": {
                "ref": [
                  "world",
                  "sheet"
                ]
              }
            }
          },
          "checks": [
            {
              "kind": "refuses",
              "error": "sheet.notFrom",
              "fields": {
                "state": "closed"
              }
            },
            {
              "kind": "no-events"
            },
            {
              "kind": "spans",
              "present": [],
