{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/**/*.test.ts"
    ]
  },
  "targetDefaults": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint {projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.oxlintrc.json",
        "{workspaceRoot}/packages/lint/baseline.json"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.json"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tsconfig.base.json"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/ci/package-test.sh {projectRoot}"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tools/ci/package-test.sh",
        "{workspaceRoot}/e2e/ratchet/check.ts",
        "{workspaceRoot}/e2e/ratchet/ratchet.ts",
        "{workspaceRoot}/e2e/ratchet/reporter.ts"
      ],
      "cache": true
    }
  },
  "sync": {
    "globalGenerators": [
      "@orthograph/generators:sync"
    ]
  }
}
