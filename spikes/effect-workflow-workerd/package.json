{
  "name": "effect-workflow-workerd",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "build": "esbuild src/worker.ts --bundle --format=esm --platform=neutral --main-fields=module,main --conditions=workerd,worker,import --outfile=dist/worker.js \"--external:node:*\" \"--external:cloudflare:*\"",
    "spike": "node --experimental-strip-types scripts/run.ts"
  },
  "dependencies": {
    "@effect/platform-cloudflare": "4.1.3",
    "effect": "4.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261101.0-beta"
  }
}
